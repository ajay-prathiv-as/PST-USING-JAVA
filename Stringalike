class Solution {
    public boolean halvesAreAlike(String s) {
        int mid = s.length() / 2;
        int c1 = 0;
        int c2 = 0;
        String v = "aeiouAEIOU";
        String a = s.substring(0,mid);
        String b = s.substring(mid,s.length());
        for(int i = 0;i < a.length();i++){
            char c = a.charAt(i);
            if(v.indexOf(c) != -1){
                c1++;
            }
        }
        for(int j = 0;j < b.length();j++){
            char d = b.charAt(j);
            if(v.indexOf(d) != -1){
                c2++;
            }
        }
        if(c1 == c2){
            return true;
        }
    return false;
    }
}
